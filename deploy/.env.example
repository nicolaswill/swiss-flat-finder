# Copy to deploy/.env and fill in. Loaded at startup by every script (app.py, scrape.py, triage.py, ...).
# Variables already set in the shell take precedence over this file.
# Keys can also be pasted into the UI instead (stored in data/secrets.json).

# AI triage (either one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Parallel AI triage requests (default 8); lower it if your API tier hits rate limits
# TRIAGE_CONCURRENCY=8

# Commute times (Google Maps Routes API)
GOOGLE_MAPS_API_KEY=

# Publishing the results to Azure Static Web Apps (publish.py, "Publish" button): the app's deployment token
# AZURE_STATIC_WEB_APPS_API_TOKEN=
